# 範例：pos.myvnc.com 路由（後台 / + 市集 /market + QR /customer）
# 合併進主機 /etc/caddy/Caddyfile 後：
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

pos.myvnc.com {
	handle_path /customer* {
		reverse_proxy http://127.0.0.1:9089
		encode gzip
	}
	handle_path /market* {
		reverse_proxy http://127.0.0.1:9090
		encode gzip
	}
	handle {
		reverse_proxy http://127.0.0.1:9088
		encode gzip
	}
}
