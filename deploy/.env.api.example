# 複製為 deploy/.env.api（此檔已列入 .gitignore，勿提交真實金鑰）
# docker-compose.prod.yml 的 api 服務會讀取 deploy/.env.api

ENV=production

# 瀏覽器開後台的網址（含埠），逗號分隔、勿尾隨 /
# 例：對外 https://shelf.taaze.tw 時填：
# CORS_ORIGINS=https://shelf.taaze.tw
CORS_ORIGINS=http://192.168.0.168:9088

# 生產環境必填：強隨機字串（>=32 bytes）
JWT_SECRET=

# 生產環境必填：Fernet 金鑰
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Resend（與 apps/api 相同變數名）
RESEND_API_KEY=
SMTP_FROM=onboarding@resend.dev

# 公開申請若啟用 CAPTCHA 再填
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
