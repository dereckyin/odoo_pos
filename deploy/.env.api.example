# 複製為 deploy/.env.api（此檔已列入 .gitignore，勿提交真實金鑰）
# docker-compose.prod.yml 的 api 服務會讀取 deploy/.env.api

ENV=production

# 瀏覽器開後台的網址（含埠），逗號分隔、勿尾隨 /
# 例：對外 https://pos.myvnc.com 時填：
# CORS_ORIGINS=https://pos.myvnc.com
CORS_ORIGINS=http://192.168.0.168:9088

# POS 開桌列印 QR 時 API 組出的顧客點餐網址前綴（勿尾隨 /）
# 例：https://pos.myvnc.com/customer 或 http://192.168.0.168:9089/customer
CUSTOMER_BASE_URL=

# 生產環境必填：強隨機字串（>=32 bytes）
JWT_SECRET=

# 生產環境必填：Fernet 金鑰
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Email（優先：SES -> Resend -> SMTP；與 apps/api 相同變數名）
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_REGION=
SENDER=
RESEND_API_KEY=
SMTP_FROM=onboarding@resend.dev

# 公開申請若啟用 CAPTCHA 再填
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
