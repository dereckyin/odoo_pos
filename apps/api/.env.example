# ---------------------------------------------------------------------------
# 一般
# ---------------------------------------------------------------------------
# dev | production（或 prod、live 亦視為生產）
ENV=dev

DATABASE_URL=postgresql+asyncpg://pos:pos@localhost:5432/pos
REDIS_URL=redis://localhost:6379/0

# 逗號分隔，勿加尾隨斜線
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# JWT（生產環境不可使用 change-me / test-secret 等弱預設值）
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
# POS 收銀機建議較長 access；refresh 愈長愈少需要重新輸入帳密
JWT_ACCESS_TTL_MIN=480
JWT_REFRESH_TTL_DAYS=90

# 租戶金流／發票金鑰在 DB 內以 Fernet 加密；生產環境必填。
# 產生方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# 限流（slowapi + Redis；RATE_LIMIT_STORAGE_URI 空白時沿用 REDIS_URL）
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE_URI=

# ---------------------------------------------------------------------------
# CAPTCHA（公開申請表用）。未設定 CAPTCHA_SECRET 時開發模式通常略過驗證。
# CAPTCHA_PROVIDER：留空 | hcaptcha | turnstile
# ---------------------------------------------------------------------------
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=

# ---------------------------------------------------------------------------
# Email / OTP（公開申請信箱驗證）。
# 優先順序：SES -> Resend -> SMTP -> stub log。
# SES 的 SENDER 需填入已在 AWS SES 驗證過的寄件者（Email 或網域信箱）。
# ---------------------------------------------------------------------------
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_REGION=
SENDER=
#
# Resend：https://resend.com  — 發信網域須在後台驗證；測試可用 onboarding@resend.dev
# （通常只能寄到該 Resend 帳號的信箱）。
# ---------------------------------------------------------------------------
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=onboarding@resend.dev
EMAIL_OTP_TTL_MIN=15

# ---------------------------------------------------------------------------
# 平台級金流／發票 fallback（僅開發或單租戶測試；正式營運請在後台「租戶設定」
# 設定每租戶商編與金鑰）
# ---------------------------------------------------------------------------

# LINE Pay — https://pay.line.me/tw/developers/apis/onlineApis
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
LINEPAY_BASE_URL=https://sandbox-api-pay.line.me
LINEPAY_CONFIRM_URL=http://localhost:8000/payments/linepay/confirm
LINEPAY_CANCEL_URL=http://localhost:8000/payments/linepay/cancel

# NewebPay 藍新
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
NEWEBPAY_BASE_URL=https://ccore.newebpay.com

# ECPay 綠界（測試環境商編／Key 請依官方文件申請，勿將正式金鑰寫入版本庫）
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_BASE_URL=https://payment-stage.ecpay.com.tw

# Ezpay 電子發票
EZPAY_MERCHANT_ID=
EZPAY_HASH_KEY=
EZPAY_HASH_IV=
EZPAY_BASE_URL=https://cinv.ezpay.com.tw

# ECPay 電子發票
ECPAY_INVOICE_MERCHANT_ID=
ECPAY_INVOICE_HASH_KEY=
ECPAY_INVOICE_HASH_IV=
ECPAY_INVOICE_BASE_URL=https://einvoice-stage.ecpay.com.tw
